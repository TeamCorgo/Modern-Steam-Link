# Steam Link config fragment, applied on top of the kernel's own
# arch/arm/configs/multi_v7_defconfig (the default config for 32-bit ARM):
#
#   make multi_v7_defconfig steamlink.config
#
# Everything not listed here keeps its upstream default. Each entry below is
# one of: something the hardware can't do, a safety rule, a constraint of the
# boot path, or something Debian userspace or containers need that is off by
# default. kernel/build.sh fails the build if any entry doesn't end up in the
# final config. See kernel/README.md.

# --- Hardware can't do it ---------------------------------------------------

# The Berlin BG2CD has a single Cortex-A9 core (the device tree lists only cpu@0)
# CONFIG_SMP is not set

# The device tree declares a gpio-restart node, but toggling that pin doesn't
# reset the SoC (per notes from another Steam Link kernel build); with the
# driver enabled, reboot hangs instead of failing
# CONFIG_POWER_RESET_GPIO_RESTART is not set

# --- Other ARM chip families: not this hardware ------------------------------
# multi_v7_defconfig supports many ARM SoCs. The Steam Link is a Marvell Berlin
# BG2CD, so every other SoC family is off; their clock, pin, power, display,
# sound and media drivers depend on them and drop out with them. Generic
# drivers for things you can plug in (USB devices, filesystems, network) keep
# their defaults. kernel/build.sh fails if any non-Berlin platform is enabled,
# including ones added upstream later.
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AT91 is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BCMBCA_BRAHMAB15 is not set
# CONFIG_ARCH_BCMBCA_CORTEXA7 is not set
# CONFIG_ARCH_BCMBCA_CORTEXA9 is not set
# CONFIG_ARCH_BCM_21664 is not set
# CONFIG_ARCH_BCM_23550 is not set
# CONFIG_ARCH_BCM_281XX is not set
# CONFIG_ARCH_BCM_5301X is not set
# CONFIG_ARCH_BCM_53573 is not set
# CONFIG_ARCH_BCM_CYGNUS is not set
# CONFIG_ARCH_BCM_HR2 is not set
# CONFIG_ARCH_BCM_NSP is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_DIGICOLOR is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_HIGHBANK is not set
# CONFIG_ARCH_HIP01 is not set
# CONFIG_ARCH_HIP04 is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_HIX5HD2 is not set
# CONFIG_ARCH_HPE is not set
# CONFIG_ARCH_HPE_GXP is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_KEYSTONE is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MILBEAUT is not set
# CONFIG_ARCH_MILBEAUT_M10V is not set
# CONFIG_ARCH_MMP is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_OMAP3 is not set
# CONFIG_ARCH_OMAP4 is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SPEAR13XX is not set
# CONFIG_ARCH_STI is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SUNPLUS is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_U8500 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VEXPRESS_TC2_PM is not set
# CONFIG_ARCH_VIRT is not set
# CONFIG_ARCH_WM8850 is not set
# CONFIG_ARCH_ZYNQ is not set
# TI SoCs that are top-level options rather than children of a family above
# CONFIG_SOC_AM33XX is not set
# CONFIG_SOC_AM43XX is not set
# CONFIG_SOC_DRA7XX is not set
# CONFIG_SOC_OMAP5 is not set

# --- Safety ------------------------------------------------------------------

# Internal NAND flash holds Valve's firmware and bootloader. With MTD off, the
# kernel has no driver that can read or write it. Never enable this.
# CONFIG_MTD is not set

# --- Boot path ---------------------------------------------------------------

# The stock firmware hands over with kexec. The kernel uses this built-in
# command line and ignores the one passed by factory_test/run.sh; this is the
# combination that has been booted and tested.
CONFIG_CMDLINE="console=ttyS0,115200 root=/dev/sda1 rw rootwait init=/lib/systemd/systemd"
CONFIG_CMDLINE_FORCE=y

# The root filesystem is on USB, and both USB PHYs need the Berlin reset
# controller (resets = <&chip_rst ...> in berlin2cd.dtsi). The default builds
# it as a module; built in, USB never depends on what the initramfs contains.
CONFIG_RESET_BERLIN=y

# --- Debian userspace (off by default) ---------------------------------------

# systemd: BPF-based cgroup features (IP filtering, device policy)
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# Compressed swap in RAM (systemd-zram-generator)
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# nftables, used by Debian's nft and iptables (netfilter is off by default)
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NETFILTER_XTABLES=m
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_HASH=m
CONFIG_NFT_NUMGEN=m
CONFIG_NFT_CONNLIMIT=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m

# --- Docker / containers (off by default) -------------------------------------
# Docker isn't installed in the image (sudo apt install docker.io), but the
# kernel supports it. CPUSETS stays off: it requires SMP, and there's one core.

# User namespaces (rootless containers; the other namespaces are on by default)
CONFIG_USER_NS=y

# cgroup controllers: memory, pids, CPU and block I/O limits
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y

# IPC and keyrings used by container runtimes
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y

# overlay2 storage driver
CONFIG_OVERLAY_FS=m

# Container networking: veth pairs on a bridge, with firewalled bridge traffic
CONFIG_VETH=m
CONFIG_BRIDGE_NETFILTER=m

# iptables (iptables-nft) matches and targets Docker's rules use
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_MARK=m

# Docker's macvlan, ipvlan and overlay (VXLAN) network drivers
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_VXLAN=m
