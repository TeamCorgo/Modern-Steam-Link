ARG DEBIAN_RELEASE=trixie
FROM docker.io/arm32v7/debian:${DEBIAN_RELEASE}

ARG DEBIAN_RELEASE
ARG KERNEL_VERSION=7.3.1
ARG KERNEL_RELEASE=${KERNEL_VERSION}-steam
ARG DEFAULT_USER=corgo
ARG DEFAULT_PASSWORD=steamlink123

ENV DEBIAN_FRONTEND=noninteractive

# Kernel, modules and the Steam Link boot hooks.
# File names shared with factory_test/run.sh and the workflow:
#   /boot/zImage, /boot/berlin2cd-valve-steamlink.dtb (from the kernel build)
#   /boot/initramfs-linux-steam.img (built below), /lib/modules/${KERNEL_RELEASE}
COPY ./kernel-${KERNEL_VERSION}/ /boot/
RUN mkdir -p /lib/modules && mv /boot/${KERNEL_RELEASE} /lib/modules/${KERNEL_RELEASE}

COPY ./rootfs/boot/* /boot/
COPY ./rootfs/usr/bin/* /usr/bin/
COPY ./rootfs/steamlink/ /steamlink/
RUN chmod 755 /usr/bin/kexec /steamlink/factory_test/run.sh

# APT sources: a classic /etc/apt/sources.list in the netinstall's format.
# rootfs/apt/sources.list is written for trixie; other releases are substituted.
COPY ./rootfs/apt/sources.list /etc/apt/sources.list
RUN rm -f /etc/apt/sources.list.d/* && \
    if [ "${DEBIAN_RELEASE}" != trixie ]; then sed -i "s/trixie/${DEBIAN_RELEASE}/g" /etc/apt/sources.list; fi

# Drop the Docker image tweaks that a real install doesn't have
# (no translations, no apt cache, auto-removing Suggests, unsafe dpkg I/O).
# policy-rc.d stays until the end so services don't try to start during the build.
RUN rm -f /etc/apt/apt.conf.d/docker-* /etc/dpkg/dpkg.cfg.d/docker-*

# Base system, the same set a netinstall gets:
#   debootstrap: every Priority required + important package
#   tasksel "standard system utilities": every Priority standard package
#   tasksel "SSH server"
RUN apt-get update && \
    apt-get dist-upgrade -y && \
    apt-get install -y \
      '?priority(required)' '?priority(important)' '?priority(standard)' \
      task-ssh-server tasksel

# The standard set already provides what the services below rely on: systemd,
# udev, dbus, systemd-timesyncd, ifupdown, dhcpcd-base and openssh-server.
# Steam Link additions on top of it:
#   initramfs-tools         builds the initramfs the handover boots
#   firmware-libertas       firmware for the Marvell Wi-Fi/Bluetooth chip
#   wireless-regdb          Wi-Fi regulatory database
#   systemd-zram-generator  compressed swap in RAM (off by default; see /etc/systemd/zram-generator.conf)
#   sudo                    admin access for the default user
#   parted                  growing the root partition (README)
#   vim                     full vim; the standard set only has vim-tiny
#   dosfstools unzip binutils libatomic1   carried over from the upstream image
RUN apt-get install -y \
      initramfs-tools firmware-libertas wireless-regdb systemd-zram-generator \
      sudo parted vim \
      dosfstools unzip binutils libatomic1

# Initramfs, built after all packages so it matches the final userspace
RUN mkinitramfs -o /boot/initramfs-linux-steam.img ${KERNEL_RELEASE}

# Default user with sudo, and a root password for `su -` (both DEFAULT_PASSWORD).
# SSH keeps Debian's default of refusing root password logins.
RUN useradd -s /bin/bash -m -G sudo,adm,users ${DEFAULT_USER} && \
    echo "${DEFAULT_USER}:${DEFAULT_PASSWORD}" | chpasswd && \
    echo "root:${DEFAULT_PASSWORD}" | chpasswd

# Helpers in the default user's home: grow the root partition to the whole stick,
# and create an optional USB swap file (see README)
COPY --chown=${DEFAULT_USER}:${DEFAULT_USER} --chmod=755 ./rootfs/home/expand_usb.sh ./rootfs/home/create_swap.sh /home/${DEFAULT_USER}/

# Config files, systemd units and drop-ins. Copied after the package installs so
# no package can replace them.
COPY ./rootfs/etc/ /etc/

# Services
RUN systemctl enable ssh dbus networking systemd-timesyncd regenerate-ssh-host-keys && \
    systemctl mask systemd-firstboot.service

# Per-device identity is created on first boot, not baked into the image:
# machine-id is generated by systemd, SSH host keys by regenerate-ssh-host-keys.service
RUN rm -f /etc/ssh/ssh_host_* && \
    rm -f /var/lib/dbus/machine-id && \
    : > /etc/machine-id

RUN apt-get clean && \
    rm -f /usr/sbin/policy-rc.d
